// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userApplications        UserApplication[]
  userPermissions         UserPermission[]
  userRoles               UserRole[]
  credentials             UserCredentials?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  ideas                   Idea[]
  tasks                   Task[]                   @relation("TaskOwner")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  chatMessages            ChatMessage[]
  projects                Project[]
  taskTemplates           TaskTemplate[]
  taskComments            TaskComment[]
  taskActivities          TaskActivity[]
  sharedTasks             TaskShare[]              @relation("TaskSharedWith")
  sharedTasksByMe         TaskShare[]              @relation("TaskSharedBy")
  notifications           Notification[]
  notificationSettings    NotificationSettings?
  taskAttachments         TaskAttachment[]
  skills                  Skill[]
  promptRecipes           PromptRecipe[]
  skillUsageEvents        SkillUsageEvent[]
  agents                  Agent[]
  agentWorkflows          AgentWorkflow[]
  agentExecutions         AgentExecution[]
  integrations            Integration[]

  @@map("users")
}

model Application {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  url         String?
  enabled     Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userApplications UserApplication[]
  permissions      Permission[]
  roles            Role[]

  @@index([enabled, createdAt])
  @@map("applications")
}

model UserApplication {
  id            String    @id @default(cuid())
  userId        String
  applicationId String
  enabled       Boolean   @default(true)
  enabledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([userId])
  @@index([applicationId])
  @@index([enabled])
  // Composite index for common query: get enabled apps for user
  @@index([userId, enabled])
  // Composite index for common query: check if user has access to app
  @@index([userId, applicationId, enabled])
  @@map("user_applications")
}

model Permission {
  id            String   @id @default(cuid())
  applicationId String
  name          String
  slug          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@unique([applicationId, slug])
  @@index([applicationId])
  @@map("permissions")
}

model UserPermission {
  id           String    @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean   @default(true)
  grantedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([granted])
  // Composite index for common query: check if user has granted permission
  @@index([userId, granted])
  // Composite index for permission checks (most common query pattern)
  @@index([userId, permissionId, granted])
  @@map("user_permissions")
}

model Role {
  id            String   @id @default(cuid())
  applicationId String
  name          String
  slug          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([applicationId, slug])
  @@index([applicationId])
  @@map("roles")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserCredentials {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([used])
  @@map("password_reset_tokens")
}

model LlmProvider {
  id           String   @id @default(cuid())
  provider     String   @unique // 'openai' | 'anthropic'
  apiKey       String // Encrypted
  enabled      Boolean  @default(true)
  configuredBy String // User ID who configured it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([provider])
  @@index([enabled])
  @@map("llm_providers")
}

// Second Brain Application Models

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TaskSharePermission {
  VIEW
  COMMENT
  EDIT
}

enum NotificationType {
  TASK_REMINDER
  TASK_ASSIGNED
  TASK_COMMENT
  TASK_OVERDUE
  TASK_SHARED
}

enum SkillStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum VersionStatus {
  DRAFT
  PUBLISHED
}

enum UsageEventType {
  VIEW
  COPY
  INCLUDE_IN_BUILDER
  BUILD_PROMPT
}

enum SkillCategory {
  Engineering
  Product
  Design
  Security
  Support
  Other
}

model Idea {
  id                String   @id @default(cuid())
  userId            String
  content           String
  convertedToTaskId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  convertedToTask Task? @relation("IdeaToTask", fields: [convertedToTaskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("ideas")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String? // Hex color for visual distinction
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@index([userId, archived])
  @@index([userId, createdAt])
  @@map("projects")
}

model Task {
  id                    String       @id @default(cuid())
  userId                String
  title                 String
  description           String?
  dueDate               DateTime?
  status                TaskStatus   @default(TODO)
  priority              TaskPriority @default(MEDIUM)
  assignee              String? // Legacy: User email or name (deprecated, use assignedUserId)
  assignedUserId        String? // Foreign key to User (EPIC-007)
  projectId             String? // Foreign key to Project
  parentTaskId          String? // For subtasks (self-referential)
  subtaskOrder          Int? // Order within parent task
  // Recurrence fields (EPIC-008)
  recurrencePattern     String? // JSON string: { type: 'daily'|'weekly'|'monthly'|'yearly'|'custom', interval: number, daysOfWeek?: number[], dayOfMonth?: number, cron?: string }
  recurrenceEndDate     DateTime? // Optional end date for recurrence
  nextRecurrenceDate    DateTime? // Next date when instance should be created
  parentRecurringTaskId String? // Link to parent recurring task template
  isRecurringTemplate   Boolean      @default(false) // True for the template, false for instances
  recurrencePaused      Boolean      @default(false) // Pause/resume recurrence
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                User             @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo          User?            @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask          Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]           @relation("TaskSubtasks")
  parentRecurringTask Task?            @relation("RecurringTaskInstances", fields: [parentRecurringTaskId], references: [id], onDelete: Cascade)
  recurringInstances  Task[]           @relation("RecurringTaskInstances")
  tags                TaskTag[]
  convertedFrom       Idea?            @relation("IdeaToTask")
  chatMessages        ChatMessage[]
  dependencies        TaskDependency[] @relation("TaskDependencies")
  dependents          TaskDependency[] @relation("TaskDependents")
  comments            TaskComment[]
  activities          TaskActivity[]
  shares              TaskShare[]
  notifications       Notification[]
  attachments         TaskAttachment[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@index([assignedUserId])
  @@index([projectId])
  @@index([parentTaskId])
  @@index([parentRecurringTaskId])
  @@index([isRecurringTemplate, nextRecurrenceDate])
  @@index([nextRecurrenceDate])
  @@map("tasks")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  taskId       String?
  type         NotificationType
  message      String
  read         Boolean          @default(false)
  snoozedUntil DateTime? // For snoozed notifications
  createdAt    DateTime         @default(now())
  readAt       DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([taskId])
  @@map("notifications")
}

model NotificationSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  enabled              Boolean  @default(true)
  defaultReminderTimes String[] // Array of reminder offsets: ["1d", "1h", "30m"]
  emailNotifications   Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileName   String
  filePath   String // Path to stored file
  fileSize   Int // Size in bytes
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedBy])
  @@map("task_attachments")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([userId])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String? // Null for system events
  action    String // 'created', 'updated', 'status_changed', 'assigned', 'commented', etc.
  details   Json? // Additional context (old value, new value, etc.)
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@index([userId])
  @@map("task_activities")
}

model TaskShare {
  id               String              @id @default(cuid())
  taskId           String
  sharedWithUserId String
  permissions      TaskSharePermission @default(VIEW)
  sharedByUserId   String
  createdAt        DateTime            @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sharedWith User @relation("TaskSharedWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedBy   User @relation("TaskSharedBy", fields: [sharedByUserId], references: [id], onDelete: Cascade)

  @@unique([taskId, sharedWithUserId])
  @@index([taskId])
  @@index([sharedWithUserId])
  @@index([sharedWithUserId, permissions])
  @@map("task_shares")
}

model TaskDependency {
  id                 String   @id @default(cuid())
  taskId             String // Task that depends on prerequisiteTaskId
  prerequisiteTaskId String // Task that must be completed first
  createdAt          DateTime @default(now())

  task             Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask Task @relation("TaskDependents", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, prerequisiteTaskId])
  @@index([taskId])
  @@index([prerequisiteTaskId])
  @@map("task_dependencies")
}

model TaskTemplate {
  id              String       @id @default(cuid())
  userId          String
  name            String
  titlePattern    String // Can include {{variables}}
  description     String?
  defaultPriority TaskPriority @default(MEDIUM)
  defaultTags     String[] // Array of default tags
  subtasks        Json? // JSON array of subtask templates
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("task_templates")
}

model TaskTag {
  id        String   @id @default(cuid())
  taskId    String
  tag       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, tag])
  @@index([taskId])
  @@index([tag])
  @@map("task_tags")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  metadata  Json? // Store extracted entities, categorization result
  taskId    String? // If message resulted in task creation
  ideaId    String? // If message resulted in idea creation
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([taskId])
  @@index([ideaId])
  @@map("chat_messages")
}

// Skills Library Models

model Skill {
  id                 String         @id @default(cuid())
  userId             String
  name               String
  description        String?
  category           SkillCategory?
  status             SkillStatus    @default(DRAFT)
  replacementSkillId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         SkillVersion[]
  tags             SkillTag[]
  usageEvents      SkillUsageEvent[]
  replacementSkill Skill?            @relation("SkillReplacement", fields: [replacementSkillId], references: [id], onDelete: SetNull)
  replacedSkills   Skill[]           @relation("SkillReplacement")

  // Indexes for common queries
  @@index([userId, status])
  @@index([userId, category])
  @@index([status])
  @@index([category])
  @@index([userId, createdAt])
  @@map("skills")
}

model SkillVersion {
  id            String        @id @default(cuid())
  skillId       String
  versionNumber Int
  content       String        @db.Text
  changeNotes   String?       @db.Text
  status        VersionStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // One published version per skill
  @@unique([skillId, versionNumber])
  @@index([skillId, status])
  @@index([skillId, versionNumber])
  @@index([status])
  @@map("skill_versions")
}

model SkillTag {
  id        String   @id @default(cuid())
  skillId   String
  tag       String
  createdAt DateTime @default(now())

  // Relations
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // Prevent duplicate tags on same skill
  @@unique([skillId, tag])
  @@index([skillId])
  @@index([tag])
  @@map("skill_tags")
}

model PromptRecipe {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  skillIds        String[] // Array of skill IDs in order
  skillVersionIds String[] // Optional array of specific version IDs
  prefix          String?  @db.Text
  suffix          String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("prompt_recipes")
}

model SkillUsageEvent {
  id        String         @id @default(cuid())
  skillId   String
  userId    String
  eventType UsageEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  // Relations
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for analytics queries
  @@index([skillId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType])
  @@index([skillId, eventType, createdAt])
  @@map("skill_usage_events")
}

// Agent Builder Models

enum AgentStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum AgentVersionStatus {
  DRAFT
  PUBLISHED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolType {
  DATABASE
  API
  PLATFORM
  FILE
  CUSTOM
}

model Agent {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  description        String?
  status             AgentStatus       @default(DRAFT)
  replacementAgentId String?
  
  // Agent Configuration
  systemPrompt       String?           @db.Text
  instructions       String?           @db.Text
  model              String?           // "gpt-4", "claude-3-opus", etc.
  temperature        Float?            @default(0.7)
  maxTokens          Int?
  toolIds            String[]          // Array of tool IDs
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  // Relations
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           AgentVersion[]
  executions         AgentExecution[]
  tags               AgentTag[]
  replacementAgent   Agent?            @relation("AgentReplacement", fields: [replacementAgentId], references: [id], onDelete: SetNull)
  replacedAgents     Agent[]           @relation("AgentReplacement")
  
  // Indexes
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status])
  @@map("agents")
}

model AgentVersion {
  id            String              @id @default(cuid())
  agentId       String
  versionNumber Int
  config        Json                // Full agent configuration snapshot
  changeNotes   String?             @db.Text
  status        AgentVersionStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  // Relations
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@unique([agentId, versionNumber])
  @@index([agentId, status])
  @@index([status])
  @@map("agent_versions")
}

model AgentWorkflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  graph       Json     // LangGraph workflow definition (nodes, edges)
  enabled     Boolean  @default(true)
  agentIds    String[] // Agents used in this workflow
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions AgentExecution[]
  
  @@index([userId])
  @@index([userId, enabled])
  @@map("agent_workflows")
}

model AgentExecution {
  id          String          @id @default(cuid())
  agentId     String?
  workflowId  String?
  userId      String
  status      ExecutionStatus @default(PENDING)
  input       Json?
  output      Json?
  state       Json?           // LangGraph state snapshots
  error       String?         @db.Text
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  
  // Relations
  agent    Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflow AgentWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([agentId])
  @@index([workflowId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("agent_executions")
}

model AgentTag {
  id        String   @id @default(cuid())
  agentId   String
  tag       String
  createdAt DateTime @default(now())
  
  // Relations
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@unique([agentId, tag])
  @@index([agentId])
  @@index([tag])
  @@map("agent_tags")
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  type        ToolType
  config      Json     // Tool-specific configuration
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type])
  @@index([enabled])
  @@map("tools")
}

// Integration Manager Models

enum IntegrationType {
  GITHUB
  // Future integrations: SLACK, JIRA, LINEAR, etc.
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

model Integration {
  id          String            @id @default(cuid())
  userId      String
  type        IntegrationType
  status      IntegrationStatus @default(DISCONNECTED)
  name        String            // User-friendly name (e.g., "My GitHub Account")
  metadata    Json?             // Integration-specific metadata (e.g., GitHub username, avatar)
  config      Json?             // Integration-specific configuration
  lastSyncAt  DateTime?         // Last successful sync/operation
  errorMessage String?          @db.Text // Last error message if status is ERROR
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials IntegrationCredential[]

  // Indexes for common queries
  @@index([userId])
  @@index([userId, type])
  @@index([userId, status])
  @@index([type])
  @@index([status])
  @@map("integrations")
}

model IntegrationCredential {
  id            String   @id @default(cuid())
  integrationId String
  key           String   // Credential key (e.g., "access_token", "refresh_token", "api_key")
  value         String   @db.Text // Encrypted credential value
  encrypted     Boolean  @default(true) // Whether value is encrypted
  expiresAt     DateTime? // For OAuth tokens that expire
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  // Prevent duplicate keys per integration
  @@unique([integrationId, key])
  @@index([integrationId])
  @@index([expiresAt]) // For finding expired tokens
  @@map("integration_credentials")
}
